{
  "name": "yap",
  "version": "1.1.1",
  "license": "MIT",
  "author": "Yap contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicremo/yap.git"
  },
  "homepage": "https://github.com/nicremo/yap",
  "private": true,
  "type": "module",
  "description": "Free, open source dictation for macOS and Windows. A Wispr Flow alternative with fast Groq transcription and optional local Whisper.",
  "keywords": [
    "dictation",
    "speech-to-text",
    "voice-to-text",
    "wispr-flow-alternative",
    "groq",
    "whisper",
    "macos",
    "windows",
    "open-source",
    "local-first"
  ],
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/dictation.e2e.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "build:native": "node scripts/build-helper-platform.js",
    "test:helper": "node scripts/helper-smoke-test.mjs",
    "package": "npm run build && npm run build:native && electron-builder",
    "release:mac": "node scripts/release-mac.mjs",
    "package:mac": "npm run build && npm run build:native && electron-builder --mac",
    "package:win": "npm run build && npm run build:native && electron-builder --win"
  },
  "build": {
    "appId": "ai.yap.desktop",
    "productName": "Yap",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!**/node_modules/@huggingface/transformers/dist/*.web*.js",
      "!**/node_modules/@huggingface/transformers/dist/transformers.js",
      "!**/node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!**/node_modules/@huggingface/transformers/dist/*.cjs",
      "!**/node_modules/@huggingface/transformers/dist/*.min.mjs",
      "!**/node_modules/@huggingface/transformers/dist/ort-*.mjs",
      "!**/node_modules/@huggingface/transformers/src/**",
      "!**/node_modules/@huggingface/transformers/types/**"
    ],
    "extraResources": [
      {
        "from": "build/native",
        "to": "native"
      },
      {
        "from": "build/icons",
        "to": "icons"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Yap records your voice while you hold the dictation key and turns it into text.",
        "LSApplicationCategoryType": "public.app-category.productivity",
        "LSUIElement": true
      },
      "icon": "build/icons/icon.icns",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/win32/**"
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "build/mac-locales",
          "to": "."
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/darwin/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Yap-${version}-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "nicremo",
      "repo": "yap"
    },
    "afterPack": "scripts/after-pack.cjs",
    "dmg": {
      "artifactName": "Yap-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.56.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.10"
  }
}
